#!/bin/sh
# Valida mensagens no padrão Conventional Commits

commit_msg_file=$1
commit_msg=$(cat "$commit_msg_file")

# Permite merges automáticos
if echo "$commit_msg" | grep -qE '^Merge '; then
  exit 0
fi

pattern='^(feat|fix|docs|style|refactor|test|chore|perf|build|ci)(\([a-z0-9._-]+\))?: .{3,}'
first_line=$(printf '%s\n' "$commit_msg" | sed '/^#/d;/^$/d' | head -n 1)

if ! printf '%s\n' "$first_line" | grep -qE "$pattern"; then
  echo "Commit rejeitado: mensagem fora do padrao." >&2
  echo "" >&2
  echo "Formato: tipo: descricao" >&2
  echo "Tipos: feat, fix, docs, style, refactor, test, chore, perf, build, ci" >&2
  echo "Exemplo: feat: adicionar secao de contato" >&2
  exit 1
fi

exit 0
